FROM mcr.microsoft.com/playwright:v1.64.1-jammy

RUN npm install -g --force corepack && corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN --mount=type=cache,id=pnpm,target=/var/cache/pnpm pnpm ci --store-dir /var/cache/pnpm

COPY . .

CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm exec next build && pnpm exec playwright test"]