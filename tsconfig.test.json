{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals", "@testing-library/user-event"],
    "paths": {
      "@/*": ["./src/*"],
      "tests/*": ["./test-browser/*"],
      "server-only": ["./src/test/stubs/server-only.ts"]
    },
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "test-browser/**/*.ts",
    "test-browser/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
