model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  username  String? @unique
  avatarUrl String? @map("avatar_url")

  updatedAt DateTime @default(now()) @updatedAt @map("update_at")
  createdAt DateTime @default(now()) @map("created_at")

  webmarks WebMark[]
  tags     Tag[]

  @@map("users")
}
